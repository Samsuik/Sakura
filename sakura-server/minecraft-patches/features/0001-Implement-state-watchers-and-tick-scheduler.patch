--- /dev/null
+++ b/me/samsuik/sakura/tracking/ChangeWatchers.java
@@ -0,0 +1,29 @@
+package me.samsuik.sakura.tracking;
+
+import it.unimi.dsi.fastutil.objects.ReferenceArraySet;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public final class ChangeWatchers<T extends Watchable<T>> {
+    private final ReferenceArraySet<ChangeListener<T>> listeners = new ReferenceArraySet<>();
+
+    public void add(final ChangeListener<T> listener) {
+        this.listeners.add(listener);
+    }
+
+    public void remove(final ChangeListener<T> listener) {
+        this.listeners.remove(listener);
+    }
+
+    public void changed(final T watchableRef) {
+        for (final ChangeListener<T> listener : this.listeners) {
+            listener.changed(watchableRef);
+        }
+    }
+
+    public void removed(final T watchableRef) {
+        for (final ChangeListener<T> listener : this.listeners) {
+            listener.removed(watchableRef);
+        }
+    }
+}
diff --git a/me/samsuik/sakura/tracking/Watchable.java b/me/samsuik/sakura/tracking/Watchable.java
new file mode 100644
index 0000000000000000000000000000000000000000..3e48e516a856d95fc792ae972bf233594b9e681e
--- /dev/null
+++ b/me/samsuik/sakura/tracking/Watchable.java
@@ -0,0 +1,16 @@
+package me.samsuik.sakura.tracking;
+
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public interface Watchable<T extends Watchable<T>> {
+    ChangeWatchers<T> watchers();
+
+    default void watch(final ChangeListener<T> listener) {
+        this.watchers().add(listener);
+    }
+
+    default void unwatch(final ChangeListener<T> listener) {
+        this.watchers().remove(listener);
+    }
+}
