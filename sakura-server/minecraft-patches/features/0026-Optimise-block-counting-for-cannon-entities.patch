@@ -2011,15 +2012,19 @@ public final class CollisionUtil {
 
                     final boolean hasSpecial = !fullBlocks && ((BlockCountingChunkSection)section).moonrise$hasSpecialCollidingBlocks(); // Sakura - collide with non-solid blocks
