+    private static @Nullable Container sakura$getSourceContainer(final Level level, final Hopper hopper, final BlockPos pos, final BlockState state) {
+        if (!(hopper instanceof HopperBlockEntity hbe) || org.bukkit.event.inventory.HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length != 0) {
+            return getSourceContainer(level, hopper, pos, state);
+        }
+
+        Container sourceContainer = hbe.containers[0];
+        if ((hbe.knownContainers & SOURCE_CONTAINER) != 0 && isValidContainer(sourceContainer)) {
+            return sourceContainer;
+        }
+
+        if (sourceContainer != null) {
+            sourceContainer.unwatch(hbe);
+        }
+
+        sourceContainer = getSourceContainer(level, hopper, pos, state);
+        hbe.listenForContainerChanges(sourceContainer, SOURCE_CONTAINER);
+        hbe.containers[0] = sourceContainer;
+
+        if (sourceContainer != null) {
+            sourceContainer.watch(hbe);
+        }
+
+        return sourceContainer;
+    }
+
+    private static @Nullable Container sakura$getAttachedContainer(final Level level, final BlockPos pos, final HopperBlockEntity hbe) {
