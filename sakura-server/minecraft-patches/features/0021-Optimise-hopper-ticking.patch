+            return getAttachedContainer(level, pos, hbe);
+        }
+
+        Container attachedContainer = hbe.containers[1];
+        if ((hbe.knownContainers & ATTACHED_CONTAINER) != 0 && isValidContainer(attachedContainer)) {
+            return attachedContainer;
+        }
+
+        if (attachedContainer != null) {
+            attachedContainer.unwatch(hbe);
+        }
+
+        attachedContainer = getAttachedContainer(level, pos, hbe);
+        hbe.listenForContainerChanges(attachedContainer, ATTACHED_CONTAINER);
+        hbe.containers[1] = attachedContainer;
+
+        if (attachedContainer != null) {
+            attachedContainer.watch(hbe);
+        }
+
+        return attachedContainer;
+    }
+
+    private void listenForContainerChanges(final @Nullable Container container, final int type) {
+        if (isValidContainer(container)) {
+            this.knownContainers |= type; // set
+        } else if ((this.knownContainers & type) != 0) {
+            this.knownContainers ^= type; // unset
+        }
+    }
+
+    private static boolean isValidContainer(@Nullable final Container container) {
+        return container != null && !container.sakura$isRemoved();
+    }
