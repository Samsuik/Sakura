@@ -0,0 +1,26 @@
+package me.samsuik.sakura.explosion.density;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.phys.Vec3;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public final class ExplosionEntityKey {
+    public static int encode(final Vec3 center, final Entity entity) {
+        return encode(center, entity.blockPosition(), entity.getType());
+    }
+
+    public static int encode(final Vec3 center, final BlockPos entityBlockPos, final EntityType<?> type) {
+        int key        = Mth.floor(center.x());
+        key = 31 * key + Mth.floor(center.y());
+        key = 31 * key + Mth.floor(center.z());
+        key = 31 * key + entityBlockPos.getX();
+        key = 31 * key + entityBlockPos.getY();
+        key = 31 * key + entityBlockPos.getZ();
+        key = 31 * key + type.hashCode();
+        return key;
+    }
+}
diff --git a/me/samsuik/sakura/explosion/density/ExplosionObstructionCache.java b/me/samsuik/sakura/explosion/density/ExplosionObstructionCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..61df4306c7abef4dbe68786721ed9055d32c0f35
--- /dev/null
+++ b/me/samsuik/sakura/explosion/density/ExplosionObstructionCache.java
@@ -0,0 +1,55 @@
+package me.samsuik.sakura.explosion.density;
+
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.objects.Object2FloatOpenHashMap;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+@SuppressWarnings("DataFlowIssue")
+@NullMarked
+public final class ExplosionObstructionCache {
+    public static final float UNKNOWN_SEEN_PERCENT = -1.0f;
+
+    private final Int2ObjectOpenHashMap<KnownObstruction> knownObstructions = new Int2ObjectOpenHashMap<>();
+    private final Object2FloatOpenHashMap<PaperObstructionCacheKey> paperObstructionCache = new Object2FloatOpenHashMap<>();
+    private long lastBlockRevision;
+
+    public @Nullable KnownObstruction getKnownObstruction(final int explosionEntityKey, final long blockRevision) {
+        if (this.lastBlockRevision != blockRevision) {
+            this.knownObstructions.clear();
+        }
+
+        return this.knownObstructions.get(explosionEntityKey);
+    }
+
+    public void addKnownObstruction(
+        final int explosionEntityKey,
+        final Vec3 center,
+        final AABB entityBox,
+        final float seenPercent,
+        final long blockRevision
+    ) {
+        this.knownObstructions.put(explosionEntityKey, new KnownObstruction(center, entityBox, seenPercent));
+        this.lastBlockRevision = blockRevision;
+    }
+
+    public float getPaperObstruction(final PaperObstructionCacheKey cacheKey) {
+        return this.paperObstructionCache.getOrDefault(cacheKey, UNKNOWN_SEEN_PERCENT);
+    }
+
+    public void addPaperObstruction(final PaperObstructionCacheKey cacheKey, final float seenPercent) {
+        this.paperObstructionCache.put(cacheKey, seenPercent);
+    }
+
+    public void tick(final long gameTime) {
+        this.knownObstructions.clear();
+        this.paperObstructionCache.clear();
+
+        if (gameTime % 200 == 0) {
+            this.knownObstructions.trim();
+            this.paperObstructionCache.trim();
+        }
+    }
+}
diff --git a/me/samsuik/sakura/explosion/density/KnownObstruction.java b/me/samsuik/sakura/explosion/density/KnownObstruction.java
new file mode 100644
index 0000000000000000000000000000000000000000..1087594cb544ee3d935737d779aad58a4982f3bb
--- /dev/null
+++ b/me/samsuik/sakura/explosion/density/KnownObstruction.java
@@ -0,0 +1,50 @@
+package me.samsuik.sakura.explosion.density;
+
+import me.samsuik.sakura.utils.AABBUtil;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.HitResult;
+import net.minecraft.world.phys.Vec3;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public final class KnownObstruction {
+    private AABB explosionBox;
+    private AABB entityBox;
+    private final float seenPercent;
+
+    public KnownObstruction(final Vec3 center, final AABB entityBox, final float seenPercent) {
+        this.explosionBox = new AABB(center, center);
+        this.entityBox = entityBox;
+        this.seenPercent = seenPercent;
+    }
+
+    public float getSeenPercent() {
+        return this.seenPercent;
+    }
+
+    public boolean isPartiallyObstructed() {
+        return this.seenPercent != 0.0f && this.seenPercent != 1.0f;
+    }
+
+    public HitResult.Type hitResult() {
+        return this.seenPercent == 1.0f ? HitResult.Type.MISS : HitResult.Type.BLOCK;
+    }
+
+    public boolean has(final Vec3 center, final AABB entityBox) {
+        return this.isExplosionKnown(center)
+            && AABBUtil.containsInclusive(this.entityBox, entityBox);
+    }
+
+    public boolean isExplosionKnown(final Vec3 center) {
+        return AABBUtil.containsInclusive(this.explosionBox, center);
+    }
+
+    public boolean isEntityPositionKnown(final Vec3 from) {
+        return AABBUtil.containsInclusive(this.entityBox, from);
+    }
+
+    public void expandKnownArea(final Vec3 center, final AABB entityBox) {
+        this.explosionBox = AABBUtil.expand(this.explosionBox, center);
+        this.entityBox    = this.entityBox.minmax(entityBox);
+    }
+}
