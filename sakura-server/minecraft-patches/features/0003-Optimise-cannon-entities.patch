diff --git a/me/samsuik/sakura/entity/EntityState.java b/me/samsuik/sakura/entity/EntityState.java
new file mode 100644
index 0000000000000000000000000000000000000000..c471afd0d7d28751de2dc61280f00e722a43943d
--- /dev/null
+++ b/me/samsuik/sakura/entity/EntityState.java
@@ -0,0 +1,75 @@
+package me.samsuik.sakura.entity;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.jspecify.annotations.NullMarked;
+
+import java.util.Optional;
+
+@NullMarked
+public record EntityState(
+    Vec3 oldPosition,
+    Vec3 position,
+    Vec3 movement,
+    AABB bb,
+    Vec3 stuckSpeed,
+    Optional<BlockPos> supportingPos,
+    boolean onGround,
+    double fallDistance
+) {
+    public static EntityState unknown() {
+        return new EntityState(
+            Vec3.ZERO,
+            Vec3.ZERO,
+            Vec3.ZERO,
+            new AABB(Vec3.ZERO, Vec3.ZERO),
+            Vec3.ZERO,
+            Optional.empty(),
+            false,
+            0.0f
+        );
+    }
+
+    public static EntityState of(final Entity entity) {
+        return new EntityState(
+            entity.oldPosition(),
+            entity.position(),
+            entity.getDeltaMovement(),
+            entity.getBoundingBox(),
+            entity.stuckSpeedMultiplier,
+            entity.mainSupportingBlockPos,
+            entity.onGround(),
+            entity.fallDistance
+        );
+    }
+
+    public void apply(final Entity entity) {
+        entity.setOldPosAndRot(this.oldPosition, 0.0f, 0.0f);
+        entity.setPos(this.position);
+        entity.setDeltaMovement(this.movement);
+        entity.setBoundingBox(this.bb);
+        entity.makeStuckInBlock(Blocks.AIR.defaultBlockState(), this.stuckSpeed);
+        entity.onGround = this.onGround;
+        entity.mainSupportingBlockPos = this.supportingPos;
+        entity.fallDistance = this.fallDistance;
+    }
+
+    public boolean isInSimilarState(final EntityState state) {
+        return this.comparePositionAndMotion(state, false)
+            && this.compareFallDistance(state);
+    }
+
+    public boolean comparePositionAndMotion(final EntityState state, final boolean strict) {
+        return this.position.equals(state.position())
+            && this.movement.equals(state.movement())
+            && (!strict || this.bb.equals(state.bb()));
+    }
+
+    public boolean compareFallDistance(final EntityState state) {
+        return this.fallDistance == state.fallDistance()
+            || this.fallDistance <= 2.5 && state.fallDistance() <= 2.5;
+    }
+}
diff --git a/me/samsuik/sakura/entity/LinkedControllers.java b/me/samsuik/sakura/entity/LinkedControllers.java
new file mode 100644
index 0000000000000000000000000000000000000000..ae8002711cad0b4f6cda24e5de37ae14690ec3f5
--- /dev/null
+++ b/me/samsuik/sakura/entity/LinkedControllers.java
@@ -0,0 +1,88 @@
+package me.samsuik.sakura.entity;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import me.samsuik.sakura.entity.data.PersistentEntityData;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.Comparator;
+import java.util.List;
+
+@NullMarked
+public final class LinkedControllers {
+    private static final Comparator<SakuraEntityController> BY_TICK_ORDER = Comparator.comparingInt(
+        controller -> controller.entity.sakura$getTickOrder()
+    );
+
+    private final List<SakuraEntityController> linked = new ObjectArrayList<>();
+    private final LongOpenHashSet linkedSpawnPositions;
+
+    public LinkedControllers(final SakuraEntityController controller) {
+        this.linked.add(controller);
+        this.linkedSpawnPositions = new LongOpenHashSet();
+    }
+
+    private LinkedControllers(final List<SakuraEntityController> controllers, final LongOpenHashSet linkedSpawnPositions) {
+        this.linked.addAll(controllers);
+        this.linkedSpawnPositions = linkedSpawnPositions;
+    }
+
+    public SakuraEntityController getHead() {
+        return this.linked.getFirst();
+    }
+
+    public int count() {
+        return this.linked.size();
+    }
+
+    public void link(final SakuraEntityController controller, final LinkedControllers links) {
+        this.linked.addAll(links.linked);
+        this.linked.sort(BY_TICK_ORDER);
+        this.linkedSpawnPositions.add(controller.encodedSpawnPosition());
+        this.linkedSpawnPositions.addAll(links.linkedSpawnPositions);
+
+        links.linked.forEach(linkedController -> linkedController.updateLinks(this));
+    }
+
+    private int findClosestIndex(final int tickOrder) {
+        int low = 0;
+        int high = this.linked.size() - 1;
+
+        while (low <= high) {
+            final int mid = (low + high) >>> 1;
+            final int midId = this.linked.get(mid).entity.sakura$getTickOrder();
+
+            if (midId <= tickOrder) {
+                low = mid + 1;
+            } else {
+                high = mid - 1;
+            }
+        }
+
+        return high;
+    }
+
+    public @Nullable Controllers decouple(final int tickOrder) {
+        final int index = this.findClosestIndex(tickOrder);
+        if (index < 0 || index + 1 >= this.linked.size()) {
+            return null;
+        }
+
+        final List<SakuraEntityController> toDecouple = this.linked.subList(0, index + 1);
+        final List<SakuraEntityController> decoupledControllers = new ObjectArrayList<>(toDecouple);
+        toDecouple.clear();
+
+        final LinkedControllers decoupled = new LinkedControllers(decoupledControllers, this.linkedSpawnPositions);
+        decoupledControllers.forEach(linkedController -> linkedController.updateLinks(decoupled));
+
+        return new Controllers(decoupled, this);
+    }
+
+    public void save(final PersistentEntityData persistentEntityData) {
+        persistentEntityData.addLinkedPositions(this.linkedSpawnPositions);
+    }
+
+    public record Controllers(LinkedControllers oldest, LinkedControllers newest) {
+    }
+}
diff --git a/me/samsuik/sakura/entity/SakuraEntity.java b/me/samsuik/sakura/entity/SakuraEntity.java
new file mode 100644
index 0000000000000000000000000000000000000000..eee90a6eb36b6325dfc09e9feea4c984241ab2aa
--- /dev/null
+++ b/me/samsuik/sakura/entity/SakuraEntity.java
@@ -0,0 +1,34 @@
+package me.samsuik.sakura.entity;
+
+import net.minecraft.world.entity.Entity;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public interface SakuraEntity {
+    SakuraEntityController getSakuraEntityController();
+
+    default Entity asEntity() {
+        return (Entity) this;
+    }
+
+    default boolean canLink(final Entity otherEntity, final int tickDifference) {
+        return true;
+    }
+
+    default boolean samePropertiesAndState(final SakuraEntity otherSakuraEntity, final int tickDifference) {
+        final SakuraEntityController otherController = otherSakuraEntity.getSakuraEntityController();
+        return this.sameProperties(otherSakuraEntity.asEntity(), tickDifference)
+            && this.isInSimilarState(otherController.getPreTickState());
+    }
+
+    default boolean isInSimilarState(final EntityState state) {
+        final SakuraEntityController controller = this.getSakuraEntityController();
+        return controller.getPreTickState().isInSimilarState(state);
+    }
+
+    default boolean sameProperties(final Entity otherEntity, final int tickDifference) {
+        return true;
+    }
+
+    default void catchupOnTicks(final int ticks) {}
+}
diff --git a/me/samsuik/sakura/entity/SakuraEntityController.java b/me/samsuik/sakura/entity/SakuraEntityController.java
new file mode 100644
index 0000000000000000000000000000000000000000..8e275c5fed4d0875a472fc3f353a1bbfdca7f75e
--- /dev/null
+++ b/me/samsuik/sakura/entity/SakuraEntityController.java
@@ -0,0 +1,217 @@
+package me.samsuik.sakura.entity;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.level.entity.ChunkEntitySlices;
+import ca.spottedleaf.moonrise.patches.chunk_system.level.entity.EntityLookup;
+import me.samsuik.sakura.entity.data.EntityData;
+import me.samsuik.sakura.entity.data.PersistentEntityData;
+import me.samsuik.sakura.entity.merge.MergeLevel;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.level.Level;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+@NullMarked
+public final class SakuraEntityController {
+    public final SakuraEntity sakuraEntity;
+    public final Entity entity;
+    private final SakuraEntityManager manager;
+    private int sleepTimer = 0;
+    private LinkedControllers links = new LinkedControllers(this);
+    private @Nullable EntityData entityData;
+    private EntityState entityState = EntityState.unknown();
+    private long blockStateRevision;
+    private boolean triedLinkingOnSpawn;
+
+    public SakuraEntityController(final SakuraEntity sakuraEntity, final SakuraEntityManager manager) {
+        this.sakuraEntity = sakuraEntity;
+        this.entity = sakuraEntity.asEntity();
+        this.manager = manager;
+    }
+
+    public long encodedSpawnPosition() {
+        final EntityData entityData = this.entityData;
+        if (entityData == null) {
+            return Long.MIN_VALUE;
+        }
+        return entityData.spawnPosition().encodedPosition();
+    }
+
+    public LinkedControllers getLinks() {
+        return this.links;
+    }
+
+    public void updateLinks(final LinkedControllers newLinks) {
+        this.links = newLinks;
+    }
+
+    public EntityState getPreTickState() {
+        return this.entityState;
+    }
+
+    public void restoreEntityState() {
+        this.entityState.apply(this.entity);
+    }
+
+    public void storeEntityState() {
+        this.entityState = EntityState.of(this.entity);
+    }
+
+    public boolean haveBlocksChangedSinceTicking(final Level level) {
+        return this.blockStateRevision != level.getBlockStateRevisionCount();
+    }
+
+    public void tickEntity() {
+        final SakuraEntity sakuraEntity = this.sakuraEntity;
+        final Entity entity = this.entity;
+
+        this.manager.updateTickingStatus(this.links, true);
+
+        if (this.isSleeping()) {
+            this.sleepTimer++;
+            return;
+        }
+
+        final SakuraEntityManager manager = this.manager;
+        final Level level = entity.level();
+
+        if (this.entityData == null) {
+            this.entityData = manager.getEntityData(entity);
+        }
+
+        this.blockStateRevision = level.getBlockStateRevisionCount();
+        this.storeEntityState();
+
+        if (!manager.tryLinkEntities(this, entity, sakuraEntity, this.entityState, this.entityData)) {
+            entity.tick();
+            entity.postTick();
+
+            if (entity.isRemoved() || this.haveBlocksChangedSinceTicking(level)) {
+                manager.decoupleTickingEntities(entity);
+            }
+        }
+
+        this.sleepTimer++;
+    }
+
+    public void removeEntity() {
+        final SakuraEntityManager manager = this.manager;
+        final EntityData entityData = this.entityData;
+
+        if (entityData != null && entityData.mergeLevel() == MergeLevel.SPAWN) {
+            final PersistentEntityData persistentEntityData = new PersistentEntityData();
+            this.links.save(persistentEntityData);
+            manager.saveEntityData(entityData, persistentEntityData);
+        }
+
+        manager.decouple(this);
+    }
+
+    public boolean canLinkOnSpawn(final SakuraEntity otherSakuraEntity) {
+        final Entity entity = this.entity;
+        if (entity.tickCount < 2 || entity.tickCount != otherSakuraEntity.asEntity().tickCount) {
+            return false;
+        }
+
+        final EntityData entityData = this.entityData;
+        if (entityData == null
+            || !entityData.hasSavedBefore()
+            || !this.canTryToLinkOnSpawn()
+            || entityData.randomChanceToSpawn()) {
+            return false;
+        }
+
+        final boolean isFallingBlock = entity.getType() == EntityTypes.FALLING_BLOCK;
+        return entityData.hasLinkedInThePast(otherSakuraEntity, isFallingBlock ? 100 : 0);
+    }
+
+    public boolean canLinkWith(
+        final SakuraEntity sakuraEntity,
+        final SakuraEntity otherSakuraEntity,
+        final SakuraEntityController otherController
+    ) {
+        final Entity otherEntity = otherSakuraEntity.asEntity();
+        final Entity entity = this.entity;
+
+        if (entity.getType() != otherEntity.getType()
+            || !entity.isAlive()
+            || !otherEntity.isAlive()
+            || otherEntity.sakura$getTickOrder() >= entity.sakura$getTickOrder()) {
+            return false;
+        }
+
+        return sakuraEntity.canLink(otherController.links.getHead().entity, 1);
+    }
+
+    public boolean canTryToLinkOnSpawn() {
+        final boolean triedLinkingOnSpawn = this.triedLinkingOnSpawn;
+        this.triedLinkingOnSpawn = true;
+        return !triedLinkingOnSpawn;
+    }
+
+    public void linkWith(final SakuraEntityController otherController) {
+        otherController.getLinks().link(this, this.getLinks());
+        this.setSleeping(true);
+    }
+
+    public void decouple(final int tickOrder) {
+        final LinkedControllers.Controllers decoupled = this.links.decouple(tickOrder);
+        if (decoupled != null) {
+            final SakuraEntityController oldestHead = decoupled.oldest().getHead();
+            final SakuraEntityController decoupledHead = decoupled.newest().getHead();
+
+            decoupledHead.entityState = oldestHead.getPreTickState();
+            decoupledHead.restoreEntityState();
+
+            // Update the entity position then wake up the entity
+            decoupledHead.entity.levelCallback.onMove();
+            decoupledHead.setSleeping(false);
+        }
+    }
+
+    public boolean isFullyAwake() {
+        return this.sleepTimer > 0;
+    }
+
+    public boolean isSleeping() {
+        return this.sleepTimer < 0;
+    }
+
+    public int sleepTicks() {
+        return this.isSleeping() ? this.sleepTimer - Integer.MIN_VALUE : 0;
+    }
+
+    public void setSleeping(final boolean sleeping) {
+        if (this.isSleeping() == sleeping) {
+            return;
+        }
+
+        final Entity entity = this.entity;
+        if (sleeping) {
+            this.sleepTimer = Integer.MIN_VALUE;
+        } else {
+            final int ticksToCatchupOn = this.sleepTimer - Integer.MIN_VALUE;
+            this.sakuraEntity.catchupOnTicks(ticksToCatchupOn);
+            this.sleepTimer = 0;
+        }
+
+        // It's not safe to wake up an entity that has already been removed
+        if (entity.isRemoved() || entity.moonrise$getSectionY() == Integer.MIN_VALUE) {
+            return;
+        }
+
+        final ServerLevel level = entity.level().getMinecraftWorld();
+        final EntityLookup lookup = level.moonrise$getEntityLookup();
+        final ChunkEntitySlices slices = lookup.getOrCreateChunk(entity.moonrise$getSectionX(), entity.moonrise$getSectionZ());
+
+        // Remove sleeping entities from the chunk map and add them back when woken up
+        if (sleeping) {
+            slices.removeEntityFromSections(entity);
+            level.chunkSource.removeEntity(entity);
+        } else {
+            slices.addEntityToSections(entity);
+            level.chunkSource.addEntity(entity);
+        }
+    }
+}
diff --git a/me/samsuik/sakura/entity/SakuraEntityManager.java b/me/samsuik/sakura/entity/SakuraEntityManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..921d421a91f5c71bc5cd965727d69663e2c2cf15
--- /dev/null
+++ b/me/samsuik/sakura/entity/SakuraEntityManager.java
@@ -0,0 +1,151 @@
+package me.samsuik.sakura.entity;
+
+import it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet;
+import me.samsuik.sakura.configuration.local.CachedLocalConfiguration;
+import me.samsuik.sakura.entity.data.EntityData;
+import me.samsuik.sakura.entity.data.EntitySpawnPosition;
+import me.samsuik.sakura.entity.data.PersistentEntityData;
+import me.samsuik.sakura.entity.merge.MergeLevel;
+import me.samsuik.sakura.utils.SimpleHashTable;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.Map;
+
+@NullMarked
+public final class SakuraEntityManager {
+    private final SimpleHashTable<BlockPos, SakuraEntity> tickedEntityPositions = new SimpleHashTable<>(128);
+    private @Nullable SakuraEntity lastEntityToTick;
+    private final ReferenceOpenHashSet<LinkedControllers> activelyTicking = new ReferenceOpenHashSet<>();
+    private final Map<EntitySpawnPosition, PersistentEntityData> entityData = new Object2ObjectOpenHashMap<>();
+
+    public SakuraEntityController createController(final SakuraEntity sakuraEntity) {
+        return new SakuraEntityController(sakuraEntity, this);
+    }
+
+    public EntityData getEntityData(final Entity entity) {
+        final EntitySpawnPosition spawnPosition = EntitySpawnPosition.from(entity);
+        final PersistentEntityData persistentEntityData = this.entityData.computeIfAbsent(spawnPosition,
+            _ -> new PersistentEntityData());
+
+        final BlockPos blockPos = entity.blockPosition();
+        final CachedLocalConfiguration localConfig = entity.level().localConfig().at(blockPos);
+
+        return new EntityData(spawnPosition, localConfig.mergeLevel, persistentEntityData);
+    }
+
+    public void saveEntityData(final EntityData entityData, final PersistentEntityData persistentEntityData) {
+        final EntitySpawnPosition entitySpawnPosition = entityData.spawnPosition();
+        final PersistentEntityData savedPersistentEntityData = this.entityData.get(entitySpawnPosition);
+
+        if (savedPersistentEntityData != null) {
+            savedPersistentEntityData.load(persistentEntityData);
+        } else {
+            this.entityData.put(entitySpawnPosition, persistentEntityData);
+        }
+    }
+
+    public boolean tryLinkEntities(
+        final SakuraEntityController controller,
+        final Entity entity,
+        final SakuraEntity sakuraEntity,
+        final EntityState currentState,
+        final EntityData entityData
+    ) {
+        final MergeLevel mergeLevel = entityData.mergeLevel();
+        final SakuraEntity otherSakuraEntity = this.getEntityToLinkWith(
+            entity, sakuraEntity, controller, currentState, mergeLevel
+        );
+
+        if (otherSakuraEntity != null) {
+            final SakuraEntityController otherController = otherSakuraEntity.getSakuraEntityController();
+            if (controller.canLinkWith(sakuraEntity, otherSakuraEntity, otherController)) {
+                controller.linkWith(otherController);
+                return true;
+            }
+        }
+
+        this.lastEntityToTick = sakuraEntity;
+        return false;
+    }
+
+    public @Nullable SakuraEntity getEntityToLinkWith(
+        final Entity entity,
+        final SakuraEntity sakuraEntity,
+        final SakuraEntityController controller,
+        final EntityState currentState,
+        final MergeLevel mergeLevel
+    ) {
+        if (mergeLevel == MergeLevel.NONE) {
+            return null;
+        }
+
+        final SakuraEntity lastSakuraEntity = this.lastEntityToTick;
+        if (lastSakuraEntity != null
+            && mergeLevel == MergeLevel.SPAWN
+            && controller.canLinkOnSpawn(lastSakuraEntity)
+            && sakuraEntity.sameProperties(lastSakuraEntity.asEntity(), 1)
+            && lastSakuraEntity.getSakuraEntityController().isFullyAwake()) {
+            return lastSakuraEntity;
+        }
+
+        SakuraEntity linkWithEntity = null;
+        if (lastSakuraEntity != null
+            && sakuraEntity.sameProperties(lastSakuraEntity.asEntity(), 1)
+            && lastSakuraEntity.isInSimilarState(currentState)) {
+            linkWithEntity = lastSakuraEntity;
+        }
+
+        if (mergeLevel == MergeLevel.LENIENT || mergeLevel == MergeLevel.SPAWN) {
+            final SakuraEntity entityWithSamePos = this.tickedEntityPositions.put(entity.blockPosition(), sakuraEntity);
+            if (linkWithEntity == null && entityWithSamePos != null && entityWithSamePos.isInSimilarState(currentState)) {
+                linkWithEntity = entityWithSamePos;
+            }
+        }
+
+        return linkWithEntity;
+    }
+
+    public void tick(final long gameTime) {
+        this.activelyTicking.clear();
+        this.lastEntityToTick = null;
+        this.tickedEntityPositions.clear();
+
+        if (gameTime % 20 == 0) {
+            this.entityData.values().removeIf(data -> data.expire(20));
+        }
+    }
+
+    public void decouple(final SakuraEntityController controller) {
+        controller.decouple(controller.entity.sakura$getTickOrder());
+        this.invalidate();
+    }
+
+    public void decoupleTickingEntities(final Entity entity) {
+        final int tickOrder = entity.sakura$getTickOrder();
+        for (final LinkedControllers linkedControllers : this.activelyTicking) {
+            linkedControllers.getHead().decouple(tickOrder);
+        }
+
+        this.activelyTicking.clear();
+        this.invalidate();
+    }
+
+    private void invalidate() {
+        if (this.lastEntityToTick != null) {
+            this.lastEntityToTick = null;
+            this.tickedEntityPositions.clear();
+        }
+    }
+
+    public void updateTickingStatus(final LinkedControllers controllers, final boolean ticking) {
+        if (ticking) {
+            this.activelyTicking.add(controllers);
+        } else {
+            this.activelyTicking.remove(controllers);
+        }
+    }
+}
diff --git a/me/samsuik/sakura/entity/data/EntityData.java b/me/samsuik/sakura/entity/data/EntityData.java
new file mode 100644
index 0000000000000000000000000000000000000000..15a4b66874a5ca78f4aa6b6f878dd01ed8a8713e
--- /dev/null
+++ b/me/samsuik/sakura/entity/data/EntityData.java
@@ -0,0 +1,33 @@
+package me.samsuik.sakura.entity.data;
+
+import me.samsuik.sakura.entity.SakuraEntity;
+import me.samsuik.sakura.entity.merge.MergeLevel;
+import org.jspecify.annotations.NullMarked;
+
+import java.util.Random;
+
+@NullMarked
+public record EntityData(EntitySpawnPosition spawnPosition, MergeLevel mergeLevel, PersistentEntityData persistentEntityData) {
+    private static final Random RANDOM = new Random();
+
+    public boolean randomChanceToSpawn() {
+        return RANDOM.nextDouble() > this.persistentEntityData.chanceToSpawnEntity();
