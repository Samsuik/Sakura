         if (configurator != null) configurator.accept(explosion); // Paper - Allow explosions to damage source
         int blockCount = explosion.explode();
         // CraftBukkit start
@@ -2015,6 +2022,29 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             return explosion;
         }
         // CraftBukkit end
+        // Sakura start - specialised explosions
+        if (explosion instanceof me.samsuik.sakura.explosion.SpecialisedExplosion<?> specialisedExplosion) {
+            me.samsuik.sakura.explosion.ExplosionToSend explosionToSend;
+            while ((explosionToSend = specialisedExplosion.getExplosionsToSend().poll()) != null) {
+                this.notifyPlayersOfExplosion(explosion, explosionToSend.position(), r, explosionToSend.blocksDestroyed(), smallExplosionParticles, largeExplosionParticles, explosionSound, blockParticles);
+            }
+        }
+
+        this.notifyPlayersOfExplosion(explosion, center, r, blockCount, smallExplosionParticles, largeExplosionParticles, explosionSound, blockParticles);
+        return explosion;
+    }
+
+    private void notifyPlayersOfExplosion(
+        final ServerExplosion explosion,
+        final Vec3 center,
+        final float r,
+        final int blockCount,
+        final ParticleOptions smallExplosionParticles,
+        final ParticleOptions largeExplosionParticles,
+        final Holder<SoundEvent> explosionSound,
+        final WeightedList<ExplosionParticleInfo> blockParticles
+    ) {
+        // Sakura end - specialised explosions
         ParticleOptions explosionParticle = explosion.isSmall() ? smallExplosionParticles : largeExplosionParticles;
 
         for (ServerPlayer player : this.players) {
@@ -2042,7 +2072,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             }
         }
 
-        return explosion; // CraftBukkit
+        explosion.getHitPlayers().clear(); // Sakura - specialised explosions
     }
 
     private Explosion.BlockInteraction getDestroyType(final GameRule<Boolean> gameRule) {
