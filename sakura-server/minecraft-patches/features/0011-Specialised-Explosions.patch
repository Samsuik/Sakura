-        ServerExplosion explosion = new ServerExplosion(this, source, damageSource, damageCalculator, center, r, fire, blockInteraction);
+        // Sakura start - specialised explosions
+        final ServerExplosion explosion;
+        if (source instanceof net.minecraft.world.entity.item.PrimedTnt tnt) {
+            explosion = new me.samsuik.sakura.explosion.TntExplosion(this, tnt, damageSource, damageCalculator, center, r, fire, blockInteraction);
+        } else {
