     }
 
     public void removeIf(final Predicate<ScheduledTick<T>> test) {
@@ -116,7 +99,7 @@ public class LevelChunkTicks<T> implements TickContainerAccess<T>, SerializableT
             ScheduledTick<T> tick = iterator.next();
             if (test.test(tick)) {
                 iterator.remove(); this.dirty = true; // Paper - rewrite chunk system
-                this.sakura$ticksPerPosition.remove(uniqueTickHash(tick)); // Sakura - optimise tick scheduling
