         ScheduledTick<T> result = this.tickQueue.poll();
         if (result != null) {
-            this.sakura$ticksPerPosition.remove(uniqueTickHash(result)); this.dirty = true; // Sakura - optimise tick scheduling // Paper - rewrite chunk system
+            this.ticksPerPosition.remove(result); this.dirty = true; // Paper - rewrite chunk system
