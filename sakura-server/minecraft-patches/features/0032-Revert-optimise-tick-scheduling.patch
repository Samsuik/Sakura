-        if (this.sakura$ticksPerPosition.add(uniqueTickHash(tick))) { // Sakura - optimise tick scheduling
+        if (this.ticksPerPosition.add(tick)) {
             this.scheduleUnchecked(tick); this.dirty = true; // Paper - rewrite chunk system
         }
     }
@@ -106,7 +89,7 @@ public class LevelChunkTicks<T> implements TickContainerAccess<T>, SerializableT
 
