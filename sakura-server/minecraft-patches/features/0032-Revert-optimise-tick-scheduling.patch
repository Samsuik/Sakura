     // Paper start - rewrite chunk system
@@ -52,27 +52,10 @@ public class LevelChunkTicks<T> implements TickContainerAccess<T>, SerializableT
         this.pendingTicks = pendingTicks;
 
         for (SavedTick<T> pendingTick : pendingTicks) {
-            this.sakura$ticksPerPosition.add(uniqueTickHash(pendingTick.type(), pendingTick.pos())); // Sakura - optimise tick scheduling
+            this.ticksPerPosition.add(ScheduledTick.probe(pendingTick.type(), pendingTick.pos()));
         }
     }
 
-    // Sakura start - optimise tick scheduling
-    private final it.unimi.dsi.fastutil.longs.LongOpenHashSet sakura$ticksPerPosition = new it.unimi.dsi.fastutil.longs.LongOpenHashSet();
-
-    private long uniqueTickHash(final ScheduledTick<T> scheduledTick) {
-        return this.uniqueTickHash(scheduledTick.type(), scheduledTick.pos());
-    }
-
-    private long uniqueTickHash(final T type, final BlockPos pos) {
-        final int x = pos.getX() & 15;
-        final int y = pos.getY() & 4095;
-        final int z = pos.getZ() & 15;
-        final int packedPos = y << 16 | x << 8 | z;
-
-        return ((long) packedPos << 32) | (long) type.hashCode();
-    }
-    // Sakura end - optimise tick scheduling
-
     public void setOnTickAdded(final @Nullable BiConsumer<LevelChunkTicks<T>, ScheduledTick<T>> onTickAdded) {
         this.onTickAdded = onTickAdded;
     }
@@ -84,7 +67,7 @@ public class LevelChunkTicks<T> implements TickContainerAccess<T>, SerializableT
