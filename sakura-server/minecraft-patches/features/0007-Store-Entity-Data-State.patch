diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index b1fc4bedd7534d9d7b3d918185c40ee6cf1c56a1..b5f4e598f0cfde878257c4424bf536677b37c703 100644
