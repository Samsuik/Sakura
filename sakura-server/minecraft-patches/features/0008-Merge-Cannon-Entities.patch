@@ -341,6 +393,7 @@ public class FallingBlockEntity extends Entity {
 
         compound.putBoolean("CancelDrop", this.cancelDrop);
         if (!this.autoExpire) compound.putBoolean("Paper.AutoExpire", false); // Paper - Expand FallingBlock API
