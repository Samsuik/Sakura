+    // Sakura start - optimise redstone and pistons around auto farms
+    private boolean destroyBlockAndMoveItems(final Level level, final BlockPos pos, final BlockState state) {
+        final Direction facing = state.getValue(FACING);
+        final BlockPos posFacingTowards = pos.relative(facing);
+        final BlockState blockToDestroy = level.getBlockState(posFacingTowards);
+        final BlockPos airGapPos = pos.relative(facing, 2);
+        final BlockState blockWithoutCollision = level.getBlockState(airGapPos);
+
+        if ((blockToDestroy.isAir() || blockToDestroy.getPistonPushReaction() == PushReaction.POPPED)
+            && blockWithoutCollision.moonrise$emptyCollisionShape()) {
+            // drop items
+            final BlockEntity blockEntity = blockToDestroy.hasBlockEntity()
+                ? level.getBlockEntity(posFacingTowards)
+                : null;
+
+            dropResources(blockToDestroy, level, airGapPos, blockEntity, pos, true);
+
+            // update piston
+            level.setBlock(pos, state.setValue(EXTENDED, true), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+            level.setBlock(posFacingTowards, Blocks.PISTON_HEAD.defaultBlockState().setValue(FACING, facing), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+            level.gameEvent(GameEvent.BLOCK_ACTIVATE, pos, GameEvent.Context.of(state));
+            return true;
+        }
+
+        return false;
+    }
+
+    private boolean retractNonSticky(final Level level, final BlockPos pos, final BlockState state) {
+        final Direction facing = state.getValue(FACING);
+        final BlockPos pistonHeadPos = pos.relative(facing);
+
+        if (level.getBlockState(pistonHeadPos).is(Blocks.PISTON_HEAD)) {
+            level.setBlock(pos, state.setValue(EXTENDED, false), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+            level.setBlock(pistonHeadPos, Blocks.AIR.defaultBlockState(), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+            level.gameEvent(GameEvent.BLOCK_DEACTIVATE, pos, GameEvent.Context.of(state));
+            return true;
+        }
+
+        return false;
+    }
+    // Sakura end - optimise redstone and pistons around auto farms
+
     private void checkIfExtend(final Level level, final BlockPos pos, final BlockState state) {
         Direction direction = state.getValue(FACING);
         boolean extend = this.getNeighborSignal(level, pos, direction);
+        // Sakura start - optimise redstone and pistons around auto farms
+        if (extend != state.getValue(EXTENDED) && level.autoFarmTracker.isTrackedAutoFarm(pos)) {
+            if (extend && this.destroyBlockAndMoveItems(level, pos, state)) {
+                return;
+            }
+
+            if (!extend && state.is(Blocks.PISTON) && this.retractNonSticky(level, pos, state)) {
+                return;
+            }
+        }
+        // Sakura end - optimise redstone and pistons around auto farms
+
         if (extend && !state.getValue(EXTENDED)) {
             if (new PistonStructureResolver(level, pos, direction, true).resolve()) {
                 level.blockEvent(pos, this, TRIGGER_EXTEND, direction.get3DDataValue());
