+    private void shareMovingBlockEntities(final List<BlockEntity> movingBlockEntities, final Direction direction) {
+        int minX = Integer.MAX_VALUE;
+        int minY = Integer.MAX_VALUE;
+        int minZ = Integer.MAX_VALUE;
+
+        int maxX = Integer.MIN_VALUE;
+        int maxY = Integer.MIN_VALUE;
+        int maxZ = Integer.MIN_VALUE;
+
+        for (final BlockEntity blockEntity : movingBlockEntities) {
+            final BlockPos blockPos = blockEntity.getBlockPos();
+            minX = Math.min(minX, blockPos.getX());
+            minY = Math.min(minY, blockPos.getY());
+            minZ = Math.min(minZ, blockPos.getZ());
+            maxX = Math.max(maxX, blockPos.getX());
+            maxY = Math.max(maxY, blockPos.getY());
+            maxZ = Math.max(maxZ, blockPos.getZ());
+        }
+
+        if (direction.getAxisDirection() == Direction.AxisDirection.POSITIVE) {
+            maxX += direction.getStepX();
+            maxY += direction.getStepY();
+            maxZ += direction.getStepZ();
+        } else {
+            minX += direction.getStepX();
+            minY += direction.getStepY();
+            minZ += direction.getStepZ();
+        }
+
+        final net.minecraft.world.phys.AABB sharedBounds = new net.minecraft.world.phys.AABB(minX, minY, minZ, maxX + 1.0, maxY + 1.50001, maxZ + 1.0);
+        final me.samsuik.sakura.utils.SharedEntities entities = new me.samsuik.sakura.utils.SharedEntities(sharedBounds);
+
+        for (final BlockEntity blockEntity : movingBlockEntities) {
+            ((PistonMovingBlockEntity) blockEntity).sharedEntities = entities;
+        }
+    }
