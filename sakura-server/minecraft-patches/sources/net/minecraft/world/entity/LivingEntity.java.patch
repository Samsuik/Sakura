+    public final float getAttackDamageFromAttributes() {
+        final AttributeInstance attackDamage = this.getAttribute(Attributes.ATTACK_DAMAGE);
+        final List<AttributeModifier> attackModifiers = new java.util.ArrayList<>();
+
+        final ItemStack heldItem = this.lastEquipmentItems.get(EquipmentSlot.MAINHAND);
+        double modifiedDamage = me.samsuik.sakura.player.combat.CombatUtil.getModifiedItemAttackDamage(this.level(), heldItem);
+        if (this.level().sakuraConfig().players.combat.oldPotionEffects) {
+            final MobEffectInstance strength = this.getEffect(MobEffects.STRENGTH);
+            if (strength != null) {
+                modifiedDamage -= me.samsuik.sakura.player.combat.CombatUtil.getEffectAttackDamage(strength);
+                attackModifiers.add(new AttributeModifier(
+                    LEGACY_STRENGTH_MODIFIER_ID,
+                    1.3 * (strength.getAmplifier() + 1),
+                    AttributeModifier.Operation.ADD_MULTIPLIED_TOTAL)
+                );
+            }
+
+            final MobEffectInstance weakness = this.getEffect(MobEffects.WEAKNESS);
+            if (weakness != null) {
+                modifiedDamage -= me.samsuik.sakura.player.combat.CombatUtil.getEffectAttackDamage(weakness) + 0.5 * (weakness.getAmplifier() + 1);
+            }
+        }
+
+        if (modifiedDamage != 0.0) {
+            attackModifiers.add(new AttributeModifier(
+                ATTACK_OVERRIDE_MODIFIER_ID,
+                modifiedDamage,
+                AttributeModifier.Operation.ADD_VALUE)
+            );
+        }
+
+        final double damage;
+        if (attackDamage == null || attackModifiers.isEmpty()) {
+            damage = this.getAttributeValue(Attributes.ATTACK_DAMAGE);
+        } else {
+            attackModifiers.forEach(attackDamage::addTransientModifier);
+            damage = this.getAttributeValue(Attributes.ATTACK_DAMAGE);
+            attackModifiers.forEach(attackDamage::removeModifier);
+        }
+
+        return (float) damage;
+    }
