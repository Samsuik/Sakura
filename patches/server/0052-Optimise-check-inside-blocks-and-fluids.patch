+                int chunkX = i >> 4;
+                for (int k = blockposition.getZ(); k <= blockposition1.getZ(); ++k) {
+                    int chunkZ = k >> 4;
+
+                    if (lastChunkX != chunkX || lastChunkZ != chunkZ) {
+                        chunk = chunkSource.getChunkAtIfLoadedMainThread(chunkX, chunkZ);
